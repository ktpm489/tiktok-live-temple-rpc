{
  "name": "chua-linh-ung-live",
  "main": "src/index.js",
  "compatibility_date": "2026-10-23",
  // Giao diện tĩnh lấy từ ../public; chỉ /ws chạy qua Worker, còn lại phục vụ thẳng từ assets
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": ["/ws"]
  },
  "durable_objects": {
    "bindings": [{ "name": "TEMPLE", "class_name": "Temple" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Temple"] }]
}
